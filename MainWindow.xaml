<Window x:Class="Norevia.PingTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Norevia Ping Tool" Height="650" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimary}"
        Foreground="{StaticResource TextPrimary}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="0,0,0,12" Style="{StaticResource Card}">
            <DockPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="●"
                       FontSize="20"
                       Foreground="{StaticResource Accent}"
                       Margin="0,0,8,0"/>
                    <StackPanel>
                        <TextBlock Text="Norevia Ping Tool"
                           FontSize="18"
                           FontWeight="Bold"/>
                        <TextBlock Text="Network diagnostics made simple"
                           FontSize="12"
                           Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="v1.0.0"
                   DockPanel.Dock="Right"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource TextMuted}"/>
            </DockPanel>
        </Border>
        <!-- TOP: Inputs -->
        <Border Grid.Row="1" Padding="12" CornerRadius="10" BorderBrush="#333"
                BorderThickness="1" Margin="0,0,0,12" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Host (domain or IP)" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Height="30" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="Count" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}" Width="80" Height="30"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                    <TextBlock Text="Timeout (ms)" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding TimeoutMs, UpdateSourceTrigger=PropertyChanged}" Width="110" Height="30"/>
                </StackPanel>

                <Button Grid.Column="3"
        Content="Start"
        Margin="12,18,0,0"
        Height="34"
        Width="95"
        Style="{StaticResource BtnPrimary}"
        Command="{Binding StartCommand}" />

                <Button Grid.Column="4"
        Content="Stop"
        Margin="8,18,0,0"
        Height="34"
        Width="95"
        Style="{StaticResource BtnDanger}"
        Command="{Binding StopCommand}" />

                <Button Grid.Column="5"
        Content="Export"
        Margin="8,18,0,0"
        Height="34"
        Width="95"
        Style="{StaticResource BtnSecondary}"
        Command="{Binding ExportCommand}" />
            </Grid>
        </Border>

        <!-- MIDDLE: Results table -->
        <Border Grid.Row="2" Padding="12" CornerRadius="10"
                BorderBrush="#333" BorderThickness="1"
                Style="{StaticResource Card}"
                >
            <DataGrid ItemsSource="{Binding Results}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="{StaticResource CardBg}"
                      Foreground="{StaticResource TextPrimary}"
                      RowBackground="#1E293B"
                      AlternatingRowBackground="#243248"
>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Seq" Binding="{Binding Seq}" Width="60"/>
                    <DataGridTemplateColumn Header="Status" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Padding="8,3" CornerRadius="999" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#334155"/>
                                            <Setter Property="BorderBrush" Value="#475569"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Success}" Value="True">
                                                    <Setter Property="Background" Value="#0B2A1E"/>
                                                    <Setter Property="BorderBrush" Value="#10B981"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Success}" Value="False">
                                                    <Setter Property="Background" Value="#2A0B0B"/>
                                                    <Setter Property="BorderBrush" Value="#EF4444"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Time (ms)" Binding="{Binding TimeMs}" Width="120"/>
                    <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="200"/>
                    <DataGridTextColumn Header="Error" Binding="{Binding ErrorMessage}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- BOTTOM: Summary -->
        <Border Grid.Row="3" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Summary" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding Sent, StringFormat=Sent: {0}}"/>
                    <TextBlock Text="{Binding Received, StringFormat=Received: {0}}"/>
                    <TextBlock Text="{Binding LossPercent, StringFormat=Loss: {0:F1}%}"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Latency" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding MinMs, StringFormat=Min: {0} ms}"/>
                    <TextBlock Text="{Binding AvgMs, StringFormat=Avg: {0:F1} ms}"/>
                    <TextBlock Text="{Binding MaxMs, StringFormat=Max: {0} ms}"/>
                    <TextBlock Text="{Binding IsRunning, StringFormat=Running: {0}}" Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="History (last 10)" FontWeight="Bold" Margin="0,0,0,6"/>
                    <ListBox ItemsSource="{Binding History}"
                 SelectedItem="{Binding SelectedHistoryItem}"
                 Height="120">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Tip: Click an item to reuse the host." Margin="0,6,0,0" Opacity="0.8"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>